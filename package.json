{
  "name": "nextjs-go-sample",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "gen:api": "openapi-typescript openapi/openapi.yaml -o apps/web/src/lib/api/schema.gen.ts",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "pnpm --filter web build-storybook",
    "e2e": "pnpm --filter e2e test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "openapi-typescript": "7.13.0"
  }
}
